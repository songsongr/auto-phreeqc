	RATES 1
	    Pyrite
	    start
	    10 k = parm(1)
	    20 a0 = parm(2)
	    30 n2 = parm(3)
	    40 nH = parm(4)
	    50 mi = parm(5)
	    90 if M <= 0 then goto 200
	    100 a_now = a0 * (M/mi)^(2/3)
	    110 o2v = TOT("O(0)")
	    120 if o2v <= 0 then o2v = 1e-12
	    130 rate = k * a_now * o2v^n2 * ACT("H+")^(-nH)
	    140 delta = rate * TIME
	    150 if delta > M then delta = M
	    200 SAVE delta
	    end
	SOLUTION 1
	    units mol/kgw
	    pH 7.0
	    pe 4.0
	    density 1.0
