TRANSPORT
    -cells 10
    -length 1.0
    -shifts 20
    -time_step 182.625 day
    -flow_direction forward
    -dispersivity 0.02
    -correct_disp true
    -punch_cells 1 5 10
    -punch_frequency 1
    -print_cells 1 5 10
    -print_frequency 5

EQUILIBRIUM_PHASES 1
    Calcite 0.0 10.0

KINETICS 1
    K-feldspar
        -formula KAlSi3O8 1
        -m 3.0
        -m0 3.0
        -parms 0.2
        -step_divide 10
        -cvode true
    Kaolinite
        -formula Al2Si2O5(OH)4 1
        -m 0.5
        -m0 0.5
        -parms 10.0
        -step_divide 10
        -cvode true

SELECTED_OUTPUT
    -file selected_transport.txt
    -reset true
    -step true
    -pH
    -pe
    -temperature
    -equilibrium_phases Calcite
    -si Calcite
    -si K-feldspar
    -si Kaolinite
    -si Quartz
    -totals Ca
    -totals K
    -totals Al
    -totals Si
    -totals C

END