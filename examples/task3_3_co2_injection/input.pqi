TITLE Supercritical CO2 injection into Ca-bearing sandstone (100°„C, 200 atm)

RATES 1
    K-feldspar
    -start
    10 rem Palandri & Kharaka (2004) parameters
    20 rem Neutral: log_k=-12.41, Ea=38 kJ/mol
    30 rem Acid: log_k=-10.06, Ea=51.7 kJ/mol, a(H+)^0.5
    40 T = 298.15 + TC
    50 T0 = 298.15
    60 R = 8.314
    70 k_neut_25 = 10^(-12.41)
    80 Ea_neut = 38000
    90 f_temp_neut = exp(Ea_neut / R * (1/T0 - 1/T))
    100 k_acid_25 = 10^(-10.06)
    110 Ea_acid = 51700
    120 f_temp_acid = exp(Ea_acid / R * (1/T0 - 1/T))
    130 act_H = ACT("H+")
    140 if act_H <= 0 then act_H = 1e-14
    150 k_neut = k_neut_25 * f_temp_neut
    160 k_acid = k_acid_25 * f_temp_acid * act_H^0.5
    170 gfm = 278.33
    180 sa_m2_per_g = parm(1)
    190 area = M * gfm * sa_m2_per_g
    200 rem Use SR() inline only (parser bug: SR() cannot be sole RHS)
    210 rate = (k_neut + k_acid) * area * (1 - SR("K-feldspar"))
    220 if rate < 0 then rate = 0
    230 moles = rate * TIME
    240 if moles > M then moles = M
    250 SAVE moles
    -end

SOLUTION 1
    units mol/kgw
    temp 100.0
    pH 7.5
    pe -4.0
    density 1.0
    Ca 0.01
    C(4) 0.01
    Na 0.043
    Cl 0.028
    K 0.0001
    Si 0.0001

GAS_PHASE 1
    -fixed_pressure
    -pressure 200.0
    CO2(g) 0.0

EQUILIBRIUM_PHASES 1
    Calcite 0.0 10.0

KINETICS 1
    K-feldspar
        -formula KAlSi3O8 1
        -m 3.0
        -m0 3.0
        -parms 0.2
        -steps 315576000 in 20 steps
        -cvode true

SELECTED_OUTPUT
    -file selected_output.txt
    -reset true
    -step true
    -pH
    -pe
    -temperature
    -equilibrium_phases Calcite
    -si Calcite
    -si K-feldspar
    -si Kaolinite
    -si Quartz
    -totals Ca
    -totals K
    -totals Al
    -totals Si
    -totals C

END